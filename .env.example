# Leave the Supabase values empty to run in demo mode (data stays in this browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, for the bill reminder cron.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
REMINDER_FROM_EMAIL="Cuenta Clara <recordatorios@example.com>"
CRON_SECRET=

# Landing page measurement (optional). Leave empty to load nothing.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_META_PIXEL_ID=

# Premium payments (Whop). scripts/whop-setup.mjs creates the product and plans.
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_PLAN_MONTHLY=
WHOP_PLAN_YEARLY=
WHOP_WEBHOOK_SECRET=
