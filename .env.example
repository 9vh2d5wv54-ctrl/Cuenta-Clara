# Leave the Supabase values empty to run in demo mode (data stays in this browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: webhooks, crons and emails.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Emails (Resend). MAILING_ADDRESS is required by CAN-SPAM.
RESEND_API_KEY=
REMINDER_FROM_EMAIL="Cuenta Clara <hola@example.com>"
MAILING_ADDRESS="Cuenta Clara, street address, city, state ZIP"
EMAIL_LINK_SECRET=
APP_URL=https://your-domain.com

# Money checkup, weekly line and "¿Me alcanza?" (Claude API).
ANTHROPIC_API_KEY=
# Demo mode has no sign-in; set to true only for local development.
ALLOW_DEMO_AI=

# Landing page measurement (optional). Leave empty to load nothing.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_META_PIXEL_ID=

# Plus payments (Whop). scripts/whop-setup.mjs creates the product and plans.
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_PLAN_MONTHLY=
WHOP_PLAN_YEARLY=
WHOP_WEBHOOK_SECRET=
